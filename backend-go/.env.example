# Copy to backend-go/.env and fill in. .env is gitignored and must stay that way (§10, §16).
# Every value here is a local-development default; none of them are safe for production.

APP_ENV=development
ADDR=:8080
LOG_LEVEL=info

# postgres from docker-compose.yml (docker-compose.yml maps the host port to 5433 precisely
# because 5432 is already taken by the legacy Express development database).
DATABASE_URL=postgres://naoja:naoja_dev_only@localhost:5433/naoja?sslmode=disable
DB_MAX_CONNS=12
DB_MIN_CONNS=1
DB_PING_TIMEOUT=3s

# Explicit origins only — the validator rejects wildcards, because credentialed cookies and
# "*" cannot coexist (this is the misconfiguration the Express service shipped with).
ALLOWED_ORIGINS=http://localhost:5173
# Local admin-console origin (split build; see docs/ADMIN-SUBDOMAIN.md)
# For local test with admin.naoja.local 127.0.0.1 in /etc/hosts:
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://admin.naoja.local:5174,http://admin.naoja.local

SESSION_COOKIE_NAME=naoja_session
TRUST_PROXY_REQUEST_ID=false

# ADR-019's session lifetime: a sliding idle window under an absolute cap, with the
# administrative window the shorter class. config.Validate refuses an inversion or a cap under
# the idle window, so a typo here stops the process instead of quietly lengthening an admin
# session forever.
SESSION_IDLE=30m
SESSION_ADMIN_IDLE=15m
SESSION_ABSOLUTE=12h

# Per-account login limiting. ADR-019 requires both halves; the per-account half is the failure
# lockout above, the per-address half is the sliding-window rate limit on /auth/register and
# /auth/login (answered 429 with Retry-After). LOGIN_RATE_LIMIT / LOGIN_RATE_WINDOW are the
# ceiling and the window; the defaults mirror the lockout policy.
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT=15m
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW=15m

HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s

# Boot-time migration is off by default: schema changes belong to the deploy step, where a
# human can take a backup first. See cmd/api/migrate_hook.go.
AUTO_MIGRATE=false

# Daraja / M-Pesa (P1). Leave MPESA_ENV empty to disable. Secrets MUST stay in .env (gitignored).
# MPESA_CALLBACK_URL must be a PUBLIC HTTPS URL reachable by Safaricom (not localhost). In dev,
# use an HTTPS tunnel (e.g. ngrok) to the Go API (ADDR, default :8080) + the callback path.
#MPESA_ENV=sandbox
#MPESA_CONSUMER_KEY=
#MPESA_CONSUMER_SECRET=
#MPESA_SHORTCODE=174379
#MPESA_PASSKEY=
#MPESA_CALLBACK_URL=https://<public-https-host>/api/payments/daraja/callback
# Production overrides (used when MPESA_ENV=production)
#MPESA_SHORTCODE_PROD=4149288
#MPESA_CALLBACK_URL_PROD=https://<your-domain>/api/payments/daraja/callback

# Cloudinary (image uploads). Leave unset to disable real uploads.
#CLOUDINARY_CLOUD_NAME=
#CLOUDINARY_API_KEY=
#CLOUDINARY_API_SECRET=

# Email / Resend (transactional). Optional.
#EMAIL_PROVIDER=resend
#RESEND_API_KEY=
#EMAIL_FROM=
#EMAIL_FROM_NAME=Naoja

# Pusher (realtime/in-app notifications). Optional.
#PUSHER_INSTANCE_ID=
#PUSHER_API_KEY=

# Public URLs (links/callback composition). Optional.
#FRONTEND_URL=http://localhost:5173
#PUBLIC_BASE_URL=https://<your-public-api-host>

# Not wired into backend-go by design (ADR-001 = Postgres-only target): SUPABASE_*, NEON_*.
# Add other provider secrets here only when their adapters are implemented.



