# Copy to backend-go/.env and fill in. .env is gitignored and must stay that way (§10, §16).
# Every value here is a local-development default; none of them are safe for production.

APP_ENV=development
ADDR=:8080
LOG_LEVEL=info

# postgres from docker-compose.yml (docker-compose.yml maps the host port to 5433 precisely
# because 5432 is already taken by the legacy Express development database).
DATABASE_URL=postgres://naoja:naoja_dev_only@localhost:5433/naoja?sslmode=disable
DB_MAX_CONNS=12
DB_MIN_CONNS=1
DB_PING_TIMEOUT=3s

# Explicit origins only — the validator rejects wildcards, because credentialed cookies and
# "*" cannot coexist (this is the misconfiguration the Express service shipped with).
ALLOWED_ORIGINS=http://localhost:5173

SESSION_COOKIE_NAME=naoja_session
TRUST_PROXY_REQUEST_ID=false

HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s

# Boot-time migration is off by default: schema changes belong to the deploy step, where a
# human can take a backup first. See cmd/api/migrate_hook.go.
AUTO_MIGRATE=false
