# ─────────────────────────────────────────────────────────────
#  Naoja Retail Shop — .gitignore
# ─────────────────────────────────────────────────────────────

# ── Dependencies ──────────────────────────────────────────────
node_modules/
jspm_packages/

# ── Build Outputs ─────────────────────────────────────────────
dist/
build/
out/
tmp/
*.tsbuildinfo

# ── Environment & Secrets (NEVER commit these) ────────────────
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
backend/.env
frontend/.env

# ── Uploaded Product Images (binary files, can be large) ──────
backend/uploads/*
!backend/uploads/.gitkeep

# ── PM2 Process Manager Logs ─────────────────────────────────
.pm2/
logs/
*.pm2

# ── npm / yarn Logs ───────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# ── OS-generated Files ────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ── Editor & IDE Files ────────────────────────────────────────
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp

# ── Test & Coverage ───────────────────────────────────────────
coverage/
.nyc_output/

# ── Docker (local only — docker-compose.override is personal) ─
docker-compose.override.yml
