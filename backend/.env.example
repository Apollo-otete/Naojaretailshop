# ==========================================
# NAOJA VENTURES RETAIL SHOP - BACKEND CONFIG
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development # Change to production when live
FRONTEND_URL=http://localhost:5173 # Production: https://yourdomain.com

# PostgreSQL Database Configuration
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_secure_postgres_password
PG_DATABASE=naoja_shop

# MongoDB Configuration (Products & Reviews)
MONGODB_URI=mongodb://localhost:27017/naoja_shop

# JWT Authentication Secret (Generate a strong random 64-char key for production)
JWT_SECRET=replace_with_a_secure_random_64_character_secret_key

# ==========================================
# SAFARICOM DARAJA M-PESA CONFIGURATION
# ==========================================
# Sandbox: https://sandbox.safaricom.co.ke
# Production: https://api.safaricom.co.ke
MPESA_BASE_URL=https://api.safaricom.co.ke

# Your Safaricom Developer Portal App Credentials
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret

# Store Shortcode / Till Number (e.g. 4149288)
MPESA_SHORTCODE=4149288

# Online Passkey from Safaricom Daraja Portal
MPESA_PASSKEY=your_mpesa_lipa_na_mpesa_online_passkey

# Publicly accessible HTTPS URL for Safaricom to POST instant payment confirmations
# Note: Safaricom requires a valid public HTTPS URL (use ngrok for local testing)
MPESA_CALLBACK_URL=https://your-domain.com/api/mpesa/callback
