{
  "name": "naoja-retail-shop",
  "version": "1.0.0",
  "description": "Naoja Retail Shop - E-Commerce Platform for Electricals & Electronics",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "make -C backend-go run",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "make -C backend-go run",
    "install:all": "npm install --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
